<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>
    <%= title || 'BoxHook' %> | BoxHook
  </title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description"
    content="BoxHook — Premium box cricket venue booking platform. Find and book the best venues near you." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>
    <%- include('../partials/messages') %>
      <main class="container">
        <%- body %>
      </main>

      <footer class="bh-footer"
        style="background: var(--bg2); border-top: 1px solid rgba(255,255,255,0.05); padding: 2rem 0; margin-top: auto;">
        <div class="container">
          <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
            <div style="color: var(--muted); font-size: 0.85rem;">
              &copy; <%= new Date().getFullYear() %> BoxHook. All rights reserved.
            </div>
            <div style="display: flex; gap: 1.5rem; font-size: 0.85rem;">
              <a href="/privacy" style="color: var(--muted); text-decoration: none;">Privacy Policy</a>
              <a href="/terms" style="color: var(--muted); text-decoration: none;">Terms of Service</a>
              <a href="/cookies" style="color: var(--muted); text-decoration: none;">Cookie Policy</a>
            </div>
          </div>
        </div>
      </footer>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>