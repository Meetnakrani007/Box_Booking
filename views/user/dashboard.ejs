<div class="bh-page-header">
    <div>
        <h1 class="bh-page-title">My Bookings</h1>
        <p style="color:var(--muted);margin-top:0.25rem;">Manage all your venue reservations</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/user/profile" class="btn-bh-outline btn-bh-sm"
            style="display:inline-flex;align-items:center;gap:0.4rem;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            Profile
        </a>
        <a href="/boxes" class="btn-bh-primary btn-bh-sm" style="display:inline-flex;align-items:center;gap:0.4rem;">
            🏏 Book a Venue
        </a>
    </div>
</div>

<% if (!bookings || bookings.length===0) { %>
    <div class="bh-section">
        <div class="bh-empty">
            <span class="bh-empty-icon" style="opacity:1;">🏏</span>
            <div style="font-size: 1.1rem; font-weight: 600; color: var(--text); margin-top: 0.5rem;">No bookings yet.
            </div>
            <div style="color: var(--muted); font-size: 0.9rem; margin-top: 0.2rem;">You haven't made any venue
                reservations.</div><br />
            <a href="/boxes" style="margin-top:0.75rem;display:inline-block;" class="btn-bh-primary btn-bh-sm">Find a
                Venue</a>
        </div>
    </div>
    <% } else { %>
        <div class="bh-section">
            <div class="bh-section-head">
                <span class="bh-section-title">All Bookings</span>
                <span style="color:var(--muted);font-size:0.82rem;">
                    <%= bookings.length %> total
                </span>
            </div>
            <div class="table-responsive">
                <table class="bh-table">
                    <thead>
                        <tr>
                            <th>Venue</th>
                            <th>Date & Time</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(function(b) { %>
                            <% const statusColors={ pending: 'warning' , confirmed: 'success' , cancelled: 'danger' ,
                                completed: 'secondary' }; %>
                                <tr>
                                    <td style="font-weight: 500;">
                                        <%= b.box ? b.box.name : 'N/A' %><br />
                                            <span style="color:var(--muted);font-size:0.8rem;">
                                                <%= b.box ? b.box.city : '' %>
                                            </span>
                                    </td>
                                    <td>
                                        <div style="font-weight: 600;">
                                            <%= b.date %>
                                        </div>
                                        <div style="font-size: 0.8rem; color: var(--muted);">
                                            <%= b.startTime %> – <%= b.endTime %>
                                        </div>
                                    </td>
                                    <td style="color:var(--green);font-weight:700;">₹<%= b.totalAmount %>
                                    </td>
                                    <td>
                                        <span class="bh-badge bh-badge-<%= statusColors[b.status] || 'secondary' %>">
                                            <%= b.status.toUpperCase() %>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <a href="/bookings/<%= b._id %>" class="btn-bh-outline btn-bh-sm">View</a>
                                            <% if (b.status==='pending' ) { %>
                                                <a href="/bookings/<%= b._id %>/pay"
                                                    style="color: var(--green); border-color: var(--green);"
                                                    class="btn-bh-outline btn-bh-sm">Pay</a>
                                                <form action="/bookings/<%= b._id %>/cancel" method="POST" class="m-0"
                                                    onsubmit="return confirm('Cancel this booking?')">
                                                    <button class="btn-bh-outline btn-bh-sm"
                                                        style="color: var(--danger); border-color: rgba(239,68,68,0.4);"
                                                        type="submit">Cancel</button>
                                                </form>
                                                <% } else if (b.status==='confirmed' ) { %>
                                                    <form action="/bookings/<%= b._id %>/cancel" method="POST"
                                                        class="m-0"
                                                        onsubmit="return confirm('Cancel confirmed booking?')">
                                                        <button class="btn-bh-outline btn-bh-sm"
                                                            style="color: var(--danger); border-color: rgba(239,68,68,0.4);"
                                                            type="submit">Cancel</button>
                                                    </form>
                                                    <% } %>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>