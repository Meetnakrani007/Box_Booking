<div class="bh-auth-wrap">
  <div class="bh-auth-card fade-up">
    <div class="bh-auth-logo"><span>🏏</span></div>
    <h2 class="bh-auth-title">Welcome Back</h2>
    <p class="bh-auth-subtitle">Sign in to your BoxHook account</p>

    <form action="/auth/login" method="POST" autocomplete="on">
      <div class="bh-form-group">
        <label class="bh-label" for="email">Email Address</label>
        <input type="email" class="bh-input" id="email" name="email" placeholder="you@example.com" required
          autocomplete="email" />
      </div>

      <div class="bh-form-group mb-2">
        <label class="bh-label" for="password">Password</label>
        <div class="bh-input-group">
          <input type="password" class="bh-input" id="password" name="password" placeholder="••••••••" required
            autocomplete="current-password" />
          <button type="button" class="bh-eye-btn" onclick="togglePw('password', this)"
            aria-label="Toggle password visibility">
            <svg id="eye-password" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
              viewBox="0 0 24 24">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
      </div>

      <div style="text-align: right; margin-bottom: 1.5rem;">
        <a href="/auth/forgot"
          style="font-size: 0.85rem; color: var(--green); font-weight: 500; text-decoration: none;">Forgot Password?</a>
      </div>

      <button type="submit" class="btn-bh-primary w-100" style="padding:0.85rem;">Sign In</button>
    </form>

    <hr class="bh-divider" />
    <p style="text-align:center;font-size:0.875rem;color:var(--muted);">
      Don't have an account?
      <a href="/auth/register" style="font-weight:600;margin-left:4px;">Create Account →</a>
    </p>
  </div>
</div>

<script>
  function togglePw(id, btn) {
    const inp = document.getElementById(id);
    const isText = inp.type === 'text';
    inp.type = isText ? 'password' : 'text';
    btn.innerHTML = isText
      ? '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
      : '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
  }
</script>