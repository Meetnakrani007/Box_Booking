<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="bh-auth-card">
            <div style="text-align:center;margin-bottom:1.5rem;">
                <div style="font-size:3rem;margin-bottom:0.5rem;">🔑</div>
                <h2 class="bh-auth-title">Forgot Password</h2>
                <p class="bh-auth-subtitle">Enter your email and we'll send you a 6-digit code to reset your password.
                </p>
            </div>

            <form action="/auth/forgot" method="POST">
                <div class="mb-4">
                    <label for="email" class="bh-label">Email Address</label>
                    <input type="email" id="email" name="email" class="bh-input"
                        placeholder="Enter your registered email" required autofocus />
                </div>

                <button type="submit" class="btn-bh-primary w-100 py-3" style="font-size: 1rem;">Send Reset
                    Code</button>
            </form>

            <div class="mt-4 text-center">
                <a href="/auth/login" class="btn-bh-link" style="font-size: 0.85rem; color: var(--muted);">← Back to
                    Login</a>
            </div>
        </div>
    </div>
</div>