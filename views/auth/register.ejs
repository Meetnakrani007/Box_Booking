<div class="bh-auth-wrap">
  <div class="bh-auth-card fade-up">
    <div class="bh-auth-logo"><span>🏏</span></div>
    <h2 class="bh-auth-title">Create Account</h2>
    <p class="bh-auth-subtitle">Join BoxHook and start booking venues today</p>

    <form action="/auth/register" method="POST" autocomplete="off" id="regForm">

      <div class="bh-form-group">
        <label class="bh-label" for="name">Full Name</label>
        <input type="text" class="bh-input" id="name" name="name" placeholder="John Doe" required />
      </div>

      <div class="bh-form-group">
        <label class="bh-label" for="email">Email Address</label>
        <input type="email" class="bh-input" id="email" name="email" placeholder="you@example.com" required
          autocomplete="email" />
      </div>

      <div class="bh-form-group">
        <label class="bh-label" for="password">Password</label>
        <div class="bh-input-group">
          <input type="password" class="bh-input" id="password" name="password" placeholder="Min 6 characters"
            minlength="6" required autocomplete="new-password" oninput="checkStrength(this.value)" />
          <button type="button" class="bh-eye-btn" onclick="togglePw('password', this)" aria-label="Show password">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
        <!-- Password Strength -->
        <div class="pw-strength" id="pwStrength" style="display:none;">
          <div class="pw-strength-bar">
            <div class="pw-strength-fill" id="pwFill"></div>
          </div>
          <span class="pw-strength-text" id="pwText" style="color:var(--muted)"></span>
        </div>
      </div>

      <div class="bh-form-group">
        <label class="bh-label" for="confirmPassword">Confirm Password</label>
        <div class="bh-input-group">
          <input type="password" class="bh-input" id="confirmPassword" name="confirmPassword"
            placeholder="Re-enter password" minlength="6" required autocomplete="new-password" oninput="checkMatch()" />
          <button type="button" class="bh-eye-btn" onclick="togglePw('confirmPassword', this)"
            aria-label="Show confirm password">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
        <span id="matchMsg" style="font-size:0.75rem;margin-top:0.25rem;display:block;"></span>
      </div>

      <button type="submit" class="btn-bh-primary w-100 mt-1" style="padding:0.85rem;">Create Account</button>
    </form>

    <hr class="bh-divider" />
    <p style="text-align:center;font-size:0.875rem;color:var(--muted);">
      Already have an account?
      <a href="/auth/login" style="font-weight:600;margin-left:4px;">Sign In →</a>
    </p>
  </div>
</div>

<script>
  function togglePw(id, btn) {
    const inp = document.getElementById(id);
    const isText = inp.type === 'text';
    inp.type = isText ? 'password' : 'text';
    btn.innerHTML = isText
      ? '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
      : '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
  }

  function checkStrength(pw) {
    const bar = document.getElementById('pwFill');
    const text = document.getElementById('pwText');
    const wrap = document.getElementById('pwStrength');
    if (!pw) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'block';
    let score = 0;
    if (pw.length >= 6) score++;
    if (pw.length >= 10) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    const levels = [
      { w: '20%', c: '#ef4444', t: 'Very Weak' },
      { w: '40%', c: '#f59e0b', t: 'Weak' },
      { w: '60%', c: '#eab308', t: 'Fair' },
      { w: '80%', c: '#22c55e', t: 'Good' },
      { w: '100%', c: '#16a34a', t: 'Strong 🔒' }
    ];
    const lvl = levels[Math.min(score, levels.length) - 1] || levels[0];
    bar.style.width = lvl.w;
    bar.style.background = lvl.c;
    text.textContent = lvl.t;
    text.style.color = lvl.c;
  }

  function checkMatch() {
    const pw = document.getElementById('password').value;
    const cpw = document.getElementById('confirmPassword').value;
    const msg = document.getElementById('matchMsg');
    if (!cpw) { msg.textContent = ''; return; }
    if (pw === cpw) {
      msg.textContent = '✓ Passwords match';
      msg.style.color = '#22c55e';
    } else {
      msg.textContent = '✗ Passwords do not match';
      msg.style.color = '#ef4444';
    }
  }
</script>