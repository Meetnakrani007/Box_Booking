<div class="bh-page-header">
    <div>
        <h1 class="bh-page-title">My Earnings</h1>
        <p style="color:var(--muted);margin-top:0.25rem;">Overview of your venue revenue</p>
    </div>
</div>

<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <label for="dateFilter" class="form-label mb-1" style="font-size:0.85rem;color:var(--muted);">Filter by
            Date</label>
        <select id="dateFilter" class="bh-select" style="max-width: 200px;" onchange="fetchOwnerRevenueData()">
            <option value="last15days">Last 15 Days</option>
            <option value="last30days" selected>Last 30 Days</option>
            <option value="currentMonth">Current Month</option>
            <option value="previousMonth">Previous Month</option>
            <option value="currentYear">Current Year</option>
            <option value="all">All Time</option>
        </select>
    </div>
</div>

<div class="row g-3 mb-5">
    <div class="col-md-3">
        <div class="bh-stat">
            <div class="bh-stat-icon green">💰</div>
            <div>
                <div class="bh-stat-value" id="stat-earnings">₹0</div>
                <div class="bh-stat-label">Total Earnings (91%)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="bh-stat">
            <div class="bh-stat-icon blue">📅</div>
            <div>
                <div class="bh-stat-value" id="stat-bookings">0</div>
                <div class="bh-stat-label">Total Bookings</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="bh-stat">
            <div class="bh-stat-icon" style="background:rgba(16,185,129,0.12);">📥</div>
            <div>
                <div class="bh-stat-value" id="stat-paid" style="color:var(--green);">₹0</div>
                <div class="bh-stat-label">Total Received</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="bh-stat">
            <div class="bh-stat-icon" style="background:rgba(245,158,11,0.12);">⏳</div>
            <div>
                <div class="bh-stat-value" id="stat-balance" style="color:var(--gold);">₹0</div>
                <div class="bh-stat-label">Pending Balance</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-12">
        <div class="bh-card p-4 h-100">
            <h5 style="margin-bottom: 1rem; font-weight: 600;">Earnings Over Time</h5>
            <canvas id="revenueChart" style="max-height: 350px;"></canvas>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-xl-6">
        <div class="bh-card p-4 h-100">
            <h5 style="margin-bottom: 1rem; font-weight: 600;">Recent Booking Earnings</h5>
            <div class="table-responsive">
                <table class="bh-table align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Venue</th>
                            <th>Gross</th>
                            <th>Your Share (91%)</th>
                        </tr>
                    </thead>
                    <tbody id="transactionTableBody">
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="bh-card p-4 h-100">
            <h5 style="margin-bottom: 1rem; font-weight: 600;">Payout History (From Admin)</h5>
            <div class="table-responsive">
                <table class="bh-table align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount Received</th>
                            <th>Reference / UTR</th>
                        </tr>
                    </thead>
                    <tbody id="payoutTableBody">
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Include Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let revenueChartInstance = null;

    async function fetchOwnerRevenueData() {
        const filter = document.getElementById('dateFilter').value;
        try {
            const res = await fetch(`/owner/api/revenue?filter=${filter}`);
            const data = await res.json();

            // Update Stats
            document.getElementById('stat-earnings').innerText = `₹${data.totalEarnings}`;
            document.getElementById('stat-bookings').innerText = data.totalBookings;
            document.getElementById('stat-paid').innerText = `₹${data.totalPaid}`;
            document.getElementById('stat-balance').innerText = `₹${data.pendingBalance}`;

            // Update Chart
            const ctx = document.getElementById('revenueChart').getContext('2d');
            if (revenueChartInstance) {
                revenueChartInstance.destroy();
            }
            revenueChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.chart.labels,
                    datasets: [{
                        label: 'Earnings (₹)',
                        data: data.chart.data,
                        backgroundColor: 'rgba(16, 185, 129, 0.8)',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });

            // Update Transactions Table
            const tbody = document.getElementById('transactionTableBody');
            if (data.recentTransactions.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">No transactions found</td></tr>';
            } else {
                tbody.innerHTML = data.recentTransactions.map(t => `
                    <tr>
                        <td>${new Date(t.paymentDate).toLocaleDateString()}</td>
                        <td>${t.box ? t.box.name : 'Unknown Venue'}</td>
                        <td style="color:var(--muted);">₹${t.totalAmount}</td>
                        <td style="color:#10b981;font-weight:600;">₹${t.ownerAmount}</td>
                    </tr>
                `).join('');
            }

            // Update Payout History Table
            const tbodyPayout = document.getElementById('payoutTableBody');
            if (data.recentPayouts.length === 0) {
                tbodyPayout.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-3">No payouts received yet</td></tr>';
            } else {
                tbodyPayout.innerHTML = data.recentPayouts.map(p => `
                    <tr>
                        <td>${new Date(p.paymentDate).toLocaleDateString()}</td>
                        <td style="color:var(--green);font-weight:700;">+₹${p.amount}</td>
                        <td><span style="font-family:monospace;font-size:0.85rem;color:var(--muted);">${p.reference || 'N/A'}</span></td>
                    </tr>
                `).join('');
            }

        } catch (err) {
            console.error('Error fetching data:', err);
        }
    }

    // Load initial data
    document.addEventListener('DOMContentLoaded', fetchOwnerRevenueData);
</script>