<div class="bh-hero">
  <div class="container">
    <div class="bh-hero-content">
      <div class="bh-hero-eyebrow fade-up">
        <svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" />
        </svg>
        India's #1 Box Cricket Booking Platform
      </div>
      <h1 class="bh-hero-title fade-up fade-up-d1">
        Book Your Perfect<br /><span>Cricket Venue</span><br />In Seconds
      </h1>
      <p class="bh-hero-sub fade-up fade-up-d2">
        Find top-rated box cricket venues near you. Filter by city, facilities, and price.
        Real-time slot availability — no more calling around.
      </p>
      <div class="bh-hero-btns fade-up fade-up-d3">
        <% if (!currentUser) { %>
          <a href="/auth/register" class="bh-hero-btn-primary">
            Get Started Free
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/boxes" class="bh-hero-btn-secondary">
            Browse Venues
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </a>
          <% } else { %>
            <a href="/boxes" class="bh-hero-btn-primary">
              Browse Venues
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
            <a href="/dashboard" class="bh-hero-btn-secondary">Go to Dashboard</a>
            <% } %>
      </div>
      <div class="bh-hero-stats fade-up">
        <div>
          <div class="bh-hero-stat-val">500+</div>
          <div class="bh-hero-stat-lbl">Venues Listed</div>
        </div>
        <div>
          <div class="bh-hero-stat-val">50K+</div>
          <div class="bh-hero-stat-lbl">Happy Players</div>
        </div>
        <div>
          <div class="bh-hero-stat-val">100+</div>
          <div class="bh-hero-stat-lbl">Cities Covered</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container py-5">
  <!-- Featured Section (3 Venues) -->
  <% if (typeof featuredBoxes !== 'undefined' && featuredBoxes && featuredBoxes.length > 0) { %>
  <section class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h2 style="font-size:1.75rem;font-weight:800;margin:0;">🔥 Featured Venues</h2>
        <p style="color:var(--muted);margin-top:0.25rem;">Hand-picked top-rated arenas for you</p>
      </div>
      <a href="/boxes" class="btn-bh-outline btn-bh-sm">View All</a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
      <% featuredBoxes.forEach(function(box, i) { %>
        <div class="col fade-up" <%= 'style="animation-delay: ' + (i * 0.1) + 's;"' %>>
          <div class="bh-card h-100">
            <% if (box.images && box.images.length> 0) { %>
              <img src="<%= box.images[0] %>" class="bh-card-img" alt="<%= box.name %>" />
              <% } else { %>
                <div class="bh-card-placeholder">🏏</div>
                <% } %>
                  <div class="bh-card-body">
                    <div class="d-flex align-items-start justify-content-between mb-1">
                      <h3 class="bh-card-title mb-0">
                        <%= box.name %>
                      </h3>
                      <span class="bh-price ms-2" style="white-space:nowrap;">₹<%= box.pricePerHour %><span
                            class="bh-price-unit">/hr</span></span>
                    </div>
                    <p class="bh-card-location">
                      📍 <%= box.location %>, <%= box.city %>
                    </p>
                    <a href="/boxes/<%= box._id %>" class="btn-bh-outline"
                      style="display:block;text-align:center;margin-top:1rem;">View Details</a>
                  </div>
          </div>
        </div>
        <% }) %>
    </div>
  </section>
  <% } %>

</div>

<style>
  .bh-card-horizontal {
    overflow: hidden;
    height: 100%;
  }

  .bh-card-img-h {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bh-card-placeholder-h {
    width: 100%;
    height: 100%;
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }
</style>