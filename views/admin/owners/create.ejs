<div class="bh-page-header">
  <div>
    <a href="/admin/owners"
      style="color:var(--muted);font-size:0.85rem;display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;margin-bottom:0.75rem;">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 12H5M12 5l-7 7 7 7" />
      </svg>
      Back to Owners
    </a>
    <h1 class="bh-page-title">Add New Owner</h1>
  </div>
</div>

<form action="/admin/owners/create" method="POST">
  <div class="row g-4">
    <div class="col-lg-6">
      <div class="bh-section">
        <div class="bh-section-head"><span class="bh-section-title">👤 Account Details</span></div>
        <div class="bh-section-body">
          <div class="bh-form-group">
            <label class="bh-label">Full Name *</label>
            <input type="text" name="name" class="bh-input" placeholder="e.g. Rajesh Patel" required />
          </div>
          <div class="bh-form-group">
            <label class="bh-label">Email Address *</label>
            <input type="email" name="email" class="bh-input" placeholder="owner@example.com" required />
          </div>
          <div class="bh-form-group">
            <label class="bh-label">Phone Number *</label>
            <input type="text" name="phone" class="bh-input" placeholder="e.g. 9876543210" required />
          </div>
          <div class="bh-form-group mb-0">
            <label class="bh-label">Password *</label>
            <div class="bh-input-group">
              <input type="password" name="password" class="bh-input" id="ownerPw" placeholder="Min 6 characters"
                required minlength="6" />
              <button type="button" class="bh-eye-btn" onclick="togglePw('ownerPw', this)">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="bh-section">
        <div class="bh-section-head"><span class="bh-section-title">🏦 Bank Details (optional)</span></div>
        <div class="bh-section-body">
          <div class="bh-form-group">
            <label class="bh-label">Account Holder Name</label>
            <input type="text" name="accountName" class="bh-input" placeholder="As on bank account" />
          </div>
          <div class="bh-form-group">
            <label class="bh-label">Account Number</label>
            <input type="text" name="accountNumber" class="bh-input" placeholder="e.g. 1234567890" />
          </div>
          <div class="row g-3">
            <div class="col-6">
              <div class="bh-form-group mb-0">
                <label class="bh-label">IFSC Code</label>
                <input type="text" name="ifsc" class="bh-input" placeholder="e.g. SBIN0001234" />
              </div>
            </div>
            <div class="col-6">
              <div class="bh-form-group mb-0">
                <label class="bh-label">Bank Name</label>
                <input type="text" name="bankName" class="bh-input" placeholder="e.g. SBI" />
              </div>
            </div>
          </div>
          <div class="bh-form-group mb-0" style="margin-top:0.75rem;">
            <label class="bh-label">UPI ID</label>
            <input type="text" name="upiId" class="bh-input" placeholder="e.g. owner@upi" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top:1.5rem;display:flex;gap:0.75rem;">
    <button type="submit" class="btn-bh-primary" style="padding:0.9rem 2rem;font-size:1rem;">👤 Create Owner</button>
    <a href="/admin/owners" class="btn-bh-outline" style="padding:0.9rem 1.5rem;">Cancel</a>
  </div>
</form>

<script>
  function togglePw(id, btn) {
    const inp = document.getElementById(id);
    const isText = inp.type === 'text';
    inp.type = isText ? 'password' : 'text';
    btn.innerHTML = isText
      ? '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>'
      : '<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
  }
</script>