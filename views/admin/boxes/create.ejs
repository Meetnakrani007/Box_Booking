<div class="bh-page-header">
  <div>
    <a href="/admin/boxes"
      style="color:var(--muted);font-size:0.85rem;display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;margin-bottom:0.75rem;">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M19 12H5M12 5l-7 7 7 7" />
      </svg>
      Back to Venues
    </a>
    <h1 class="bh-page-title">Add New Venue</h1>
  </div>
</div>

<form action="/admin/boxes/create" method="POST" enctype="multipart/form-data">
  <div class="row g-4">
    <!-- Left column -->
    <div class="col-lg-6">
      <div class="bh-section">
        <div class="bh-section-head"><span class="bh-section-title">🏟️ Venue Details</span></div>
        <div class="bh-section-body">
          <div class="bh-form-group">
            <label class="bh-label">Venue Name *</label>
            <input type="text" name="name" class="bh-input" placeholder="e.g. Champions Box Cricket" required />
          </div>
          <div class="bh-form-group">
            <label class="bh-label">Location / Address *</label>
            <input type="text" name="location" class="bh-input" placeholder="e.g. Vastrapur, near lake" required />
          </div>
          <div class="bh-form-group">
            <label class="bh-label">City *</label>
            <input type="text" name="city" class="bh-input" placeholder="e.g. Ahmedabad" required />
          </div>
          <div class="bh-form-group">
            <label class="bh-label">Price per Hour (₹) *</label>
            <input type="number" name="pricePerHour" min="0" step="1" class="bh-input" placeholder="e.g. 800"
              required />
          </div>
          <div class="bh-form-group mb-0">
            <label class="bh-label">Description</label>
            <textarea name="description" class="bh-input" rows="3" placeholder="Describe the venue..."
              style="resize:vertical;"></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column -->
    <div class="col-lg-6">
      <div class="bh-section mb-4">
        <div class="bh-section-head"><span class="bh-section-title">🏅 Facilities</span></div>
        <div class="bh-section-body">
          <div class="bh-check-grid">
            <% facilities.forEach(function(facility) { %>
              <label class="bh-check-item">
                <input type="checkbox" name="facilities" value="<%= facility %>" />
                <span class="bh-check-label">
                  <%= facility %>
                </span>
              </label>
              <% }) %>
          </div>
        </div>
      </div>

      <div class="bh-section mb-4">
        <div class="bh-section-head"><span class="bh-section-title">📍 GPS Coordinates (optional)</span></div>
        <div class="bh-section-body">
          <div class="row g-3">
            <div class="col-6">
              <div class="bh-form-group mb-0">
                <label class="bh-label">Latitude</label>
                <input type="number" step="0.000001" name="latitude" class="bh-input" placeholder="23.0225" />
              </div>
            </div>
            <div class="col-6">
              <div class="bh-form-group mb-0">
                <label class="bh-label">Longitude</label>
                <input type="number" step="0.000001" name="longitude" class="bh-input" placeholder="72.5714" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="bh-section">
        <div class="bh-section-head"><span class="bh-section-title">🖼️ Images (up to 5)</span></div>
        <div class="bh-section-body">
          <input type="file" name="images" class="bh-input" multiple accept="image/*" style="padding:0.6rem;" />
          <small style="color:var(--muted);font-size:0.75rem;margin-top:0.4rem;display:block;">JPG, PNG, WebP · Max 5
            images</small>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top:1.5rem;display:flex;gap:0.75rem;">
    <button type="submit" class="btn-bh-primary" style="padding:0.9rem 2rem;font-size:1rem;">🏟️ Create Venue</button>
    <a href="/admin/boxes" class="btn-bh-outline" style="padding:0.9rem 1.5rem;">Cancel</a>
  </div>
</form>