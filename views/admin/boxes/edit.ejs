<h1 class="bh-auth-title" style="margin-bottom: 2rem; text-align: left;">Edit Box</h1>

<form action="/admin/boxes/<%= box._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
  <div class="row">
    <!-- Left Column: Primary Details -->
    <div class="col-md-6 mb-4">
      <div class="bh-card" style="box-shadow: none;">
        <div class="mb-3">
          <label class="bh-label">Name</label>
          <input type="text" name="name" class="bh-input" value="<%= box.name %>" required />
        </div>
        <div class="mb-3">
          <label class="bh-label">Location</label>
          <input type="text" name="location" class="bh-input" value="<%= box.location %>" required />
        </div>
        <div class="mb-3">
          <label class="bh-label">City</label>
          <input type="text" name="city" class="bh-input" value="<%= box.city %>" required />
        </div>
        <div class="mb-3">
          <label class="bh-label">Price per Hour (₹)</label>
          <input type="number" name="pricePerHour" min="0" step="0.01" class="bh-input" value="<%= box.pricePerHour %>"
            required />
        </div>
        <div class="mb-3">
          <label class="bh-label">Description</label>
          <textarea name="description" class="bh-input" rows="4"
            style="resize: vertical;"><%= box.description || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Right Column: Facilities & Media -->
    <div class="col-md-6 mb-4">

      <!-- Facilities -->
      <h5 style="color:var(--text); font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem;">Facilities</h5>
      <div class="row mb-4">
        <% facilities.forEach(function(facility) { %>
          <div class="col-6 col-md-4 mb-2">
            <div class="form-check custom-checkbox">
              <input class="form-check-input" type="checkbox" name="facilities" value="<%= facility %>"
                id="facility-<%= facility.replace(/\s+/g, '-') %>" <%=box.facilities &&
                box.facilities.includes(facility) ? 'checked' : '' %>
              />
              <label class="form-check-label" for="facility-<%= facility.replace(/\s+/g, '-') %>"
                style="color: var(--muted); font-size: 0.9rem;">
                <%= facility %>
              </label>
            </div>
          </div>
          <% }) %>
      </div>

      <!-- GPS Location -->
      <h5 style="color:var(--text); font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem;">Location (optional)</h5>
      <div class="mb-3">
        <label class="bh-label">Latitude</label>
        <input type="number" step="0.000001" name="latitude" class="bh-input" value="<%= box.latitude || '' %>"
          placeholder="e.g. 23.0225" />
      </div>
      <div class="mb-4">
        <label class="bh-label">Longitude</label>
        <input type="number" step="0.000001" name="longitude" class="bh-input" value="<%= box.longitude || '' %>"
          placeholder="e.g. 72.5714" />
      </div>

      <!-- Replace Images -->
      <h5 style="color:var(--text); font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem;">Replace Images</h5>
      <% if (box.images && box.images.length> 0) { %>
        <div class="d-flex flex-wrap gap-2 mb-3 p-3"
          style="background: var(--surface); border: 1px solid var(--border); border-radius: 8px;">
          <% box.images.forEach(function(img) { %>
            <div style="position: relative; overflow: hidden; border-radius: 6px; border: 1px solid var(--border);">
              <img src="<%= img %>" style="height:70px; width:100px; object-fit:cover;" />
            </div>
            <% }) %>
        </div>
        <% } %>
          <div class="mb-3">
            <input type="file" name="images" class="bh-input" multiple style="padding: 0.5rem;" />
            <small style="color: var(--muted); font-size: 0.8rem; display: block; margin-top: 0.4rem;">Upload up to 5
              images (will replace existing ones).</small>
          </div>

    </div>
  </div>

  <hr class="bh-divider mb-4" />

  <div class="d-flex gap-3 pb-5">
    <button type="submit" class="btn-bh-primary px-4">Update Box Details</button>
    <a href="/admin/boxes" class="btn-bh-outline px-4">Cancel</a>
  </div>
</form>

<style>
  /* Custom checkbox styling to match dark theme */
  .custom-checkbox .form-check-input {
    background-color: var(--surface);
    border-color: var(--border);
  }

  .custom-checkbox .form-check-input:checked {
    background-color: var(--green);
    border-color: var(--green);
  }

  .custom-checkbox .form-check-input:focus {
    box-shadow: 0 0 0 0.25rem rgba(34, 197, 94, 0.25);
    border-color: var(--green);
  }
</style>