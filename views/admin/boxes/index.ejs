<div class="bh-page-header">
  <div>
    <h1 class="bh-page-title">Manage Venues</h1>
    <p style="color:var(--muted);margin-top:0.25rem;">
      <%= boxes.length %> venue<%= boxes.length !==1 ? 's' : '' %> listed
    </p>
  </div>
  <a href="/admin/boxes/create" class="btn-bh-primary btn-bh-sm">+ Add Venue</a>
</div>

<div class="bh-section">
  <% if (!boxes || boxes.length===0) { %>
    <div class="bh-empty">
      <span class="bh-empty-icon">🏟️</span>
      No venues yet. <a href="/admin/boxes/create">Add the first one →</a>
    </div>
    <% } else { %>
      <div style="overflow-x:auto;">
        <table class="bh-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Location</th>
              <th>Price/hr</th>
              <th>Owner</th>
              <th>Facilities</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% boxes.forEach(function(box) { %>
              <tr>
                <td><strong>
                    <%= box.name %>
                  </strong></td>
                <td style="color:var(--muted);">
                  <%= box.location %>, <%= box.city %>
                </td>
                <td style="color:var(--green);font-weight:700;">₹<%= box.pricePerHour %>
                </td>
                <td>
                  <%= box.owner ? (box.owner.user ? box.owner.user.name : '—' ) : '—' %>
                </td>
                <td>
                  <% (box.facilities || []).slice(0,2).forEach(function(f) { %>
                    <span class="bh-badge-facility me-1">
                      <%= f %>
                    </span>
                    <% }) %>
                      <% if (box.facilities && box.facilities.length> 2) { %>
                        <span style="color:var(--muted);font-size:0.72rem;">+<%= box.facilities.length-2 %></span>
                        <% } %>
                </td>
                <td>
                  <div style="display:flex;gap:0.4rem;">
                    <a href="/admin/boxes/<%= box._id %>/edit" class="btn-bh-outline btn-bh-sm">Edit</a>
                    <form action="/admin/boxes/<%= box._id %>?_method=DELETE" method="POST"
                      onsubmit="return confirm('Delete this venue?')">
                      <button class="btn-bh-danger btn-bh-sm" type="submit">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
</div>