<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <a href="/boxes/<%= box._id %>"
                style="color:var(--muted);font-size:0.85rem;display:inline-flex;align-items:center;gap:0.4rem;text-decoration:none;">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M19 12H5M12 5l-7 7 7 7" />
                </svg>
                Back to venue
            </a>
        </div>

        <h1 style="font-size:1.75rem;font-weight:800;margin-bottom:0.3rem;">Book: <%= box.name %>
        </h1>
        <p style="color:var(--muted);margin-bottom:1.75rem;">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                style="margin-right:3px;">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
            <%= box.location %>, <%= box.city %> &nbsp;·&nbsp; <span style="color:var(--green);font-weight:700;">₹<%=
                            box.pricePerHour %>/hr</span>
        </p>

        <div class="bh-section">
            <div class="bh-section-head">
                <span class="bh-section-title">📅 Select Date & Time</span>
            </div>
            <div class="bh-section-body">
                <form action="/bookings" method="POST" id="bookingForm">
                    <input type="hidden" name="boxId" value="<%= box._id %>" />

                    <div class="bh-form-group">
                        <label class="bh-label">Date</label>
                        <input type="date" name="date" class="bh-input" id="bookDate" required
                            min="<%= new Date().toISOString().split('T')[0] %>" />
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="bh-form-group mb-0">
                                <label class="bh-label">Start Time</label>
                                <input type="time" name="startTime" class="bh-input" id="startTime" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bh-form-group mb-0">
                                <label class="bh-label">End Time</label>
                                <input type="time" name="endTime" class="bh-input" id="endTime" required />
                            </div>
                        </div>
                    </div>

                    <!-- Live Amount Preview -->
                    <div id="amtPreview"
                        style="display:none;margin-top:1.25rem;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.2);border-radius:var(--radius-sm);padding:1rem 1.25rem;">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <span style="color:var(--muted);font-size:0.875rem;">Estimated Amount</span>
                            <span id="previewAmt" style="color:var(--green);font-size:1.3rem;font-weight:800;"></span>
                        </div>
                        <div style="color:var(--muted);font-size:0.75rem;margin-top:0.25rem;">
                            <span id="previewHrs"></span> × ₹<%= box.pricePerHour %>/hr
                        </div>
                    </div>

                    <button type="submit" class="btn-bh-primary mt-4" style="width:100%;padding:0.9rem;font-size:1rem;">
                        Proceed to Payment →
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const pricePerHour = <%= box.pricePerHour %>;
    function calcAmount() {
        const start = document.getElementById('startTime').value;
        const end = document.getElementById('endTime').value;
        const preview = document.getElementById('amtPreview');
        if (!start || !end) { preview.style.display = 'none'; return; }
        const [sh, sm] = start.split(':').map(Number);
        const [eh, em] = end.split(':').map(Number);
        const hours = ((eh * 60 + em) - (sh * 60 + sm)) / 60;
        if (hours <= 0) { preview.style.display = 'none'; return; }
        document.getElementById('previewAmt').textContent = '₹' + Math.round(hours * pricePerHour);
        document.getElementById('previewHrs').textContent = hours.toFixed(1) + ' hrs';
        preview.style.display = 'block';
    }
    document.getElementById('startTime').addEventListener('change', calcAmount);
    document.getElementById('endTime').addEventListener('change', calcAmount);
</script>